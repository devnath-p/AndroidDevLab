<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LabExam"
            android:textColor="@color/primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student Course Feedback"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="20dp" />


        <!-- STUDENT DETAILS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Details"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="15dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/rounded_input"
                android:hint="Student Name"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/rounded_input"
                android:hint="Email Address"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textEmailAddress"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etCourseName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/rounded_input"
                android:hint="Course Name"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:layout_marginTop="12dp" />

        </LinearLayout>


        <!-- RATING CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Course Rating"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How would you rate your experience?"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbExcellent"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Excellent"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/rbGood"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Good"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/rbAverage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Average"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:buttonTint="@color/primary" />

                <RadioButton
                    android:id="@+id/rbPoor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Poor"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:buttonTint="@color/primary" />

            </RadioGroup>

        </LinearLayout>


        <!-- RECOMMENDATION CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Course Recommendation"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Would you recommend this course?"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="3dp" />

            <ToggleButton
                android:id="@+id/toggleRecommend"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:textOn="YES"
                android:textOff="NO"
                android:text="NO"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

        </LinearLayout>


        <!-- TERMS -->

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I agree to the terms and conditions"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:buttonTint="@color/primary"
            android:layout_marginBottom="12dp" />


        <!-- SUBMIT -->

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SUBMIT FEEDBACK"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_button" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for helping us improve."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp" />

    </LinearLayout>

</ScrollView>